<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ContractDetailActivity">

    <!-- Toolbar for the detail screen -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_detail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorAccent"
        android:elevation="4dp"
        android:paddingTop="10px"
        android:paddingBottom="10px"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:logo="@drawable/zenroom_logotype"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" /> <!-- YOUR LOGO HERE -->

    <!-- ScrollView contains the rest of the layout -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- Your existing LinearLayout with EditTexts and Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- All your TextView, EditText, Button, etc. go here -->
            <!-- ... (The rest of the file is the same as before) ... -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contract Script"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTextContract"
                android:layout_width="match_parent"
                android:layout_height="301dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/editbox_background"
                android:gravity="top|start"
                android:inputType="textMultiLine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keys (JSON)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTextKeys"
                android:layout_width="match_parent"
                android:layout_height="249dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/editbox_background"
                android:gravity="top|start"
                android:inputType="textMultiLine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data (JSON)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTextData"
                android:layout_width="match_parent"
                android:layout_height="341dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/editbox_background"
                android:gravity="top|start"
                android:inputType="textMultiLine" />



            <Button
                android:id="@+id/buttonExecute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Execute Contract" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Result:"
                android:textStyle="bold" />

            <WebView
                android:id="@+id/webViewResult"
                android:layout_width="match_parent"
                android:layout_height="300dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>